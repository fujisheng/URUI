<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
  <Type Name="URUI::Variant">
    <DisplayString Condition="type == '-'">{type,en}</DisplayString>
    <DisplayString Condition="type == 'B'">{type,en}: {*((bool*)data)}</DisplayString>
    <DisplayString Condition="type == 'b'">{type,en}: {*((URUI::byte*)data)}</DisplayString>
    <DisplayString Condition="type == 'c'">{type,en}: '{*((char*)data)}'</DisplayString>
    <DisplayString Condition="type == 'f'">{type,en}: {*((float*)data)}</DisplayString>
    <DisplayString Condition="type == 'd'">{type,en}: {*((double*)data)}</DisplayString>
    <DisplayString Condition="type == 'i'">{type,en}: {*((int*)data)}</DisplayString>
    <DisplayString Condition="type == 'I'">{type,en}: {*((int64_t*)data)}</DisplayString>
    <DisplayString Condition="type == 'u'">{type,en}: {*((unsigned int*)data)}</DisplayString>
    <DisplayString Condition="type == 'U'">{type,en}: {*((uint64_t*)data)}</DisplayString>
    <DisplayString Condition="type == 's'">{type,en}: {*((URUI::String*)data)}</DisplayString>
    <DisplayString Condition="type == '2'">{type,en}: {*((URUI::Vector2f*)data)}</DisplayString>
    <DisplayString Condition="type == '3'">{type,en}: {*((URUI::Vector3f*)data)}</DisplayString>
    <DisplayString Condition="type == '4'">{type,en}: {*((URUI::Vector4f*)data)}</DisplayString>
    <DisplayString Condition="type == 'g'">{type,en}: {*((URUI::Colourf*)data)}</DisplayString>
    <DisplayString Condition="type == 'h'">{type,en}: {*((URUI::Colourb*)data)}</DisplayString>
    <DisplayString Condition="type == 'p'">{type,en}: {*((URUI::ScriptInterface**)data)}</DisplayString>
    <DisplayString Condition="type == 't'">{type,en}: {*((URUI::TransformPtr*)data)}</DisplayString>
    <DisplayString Condition="type == 'T'">{type,en}: {*((URUI::TransitionList*)data)}</DisplayString>
    <DisplayString Condition="type == 'A'">{type,en}: {*((URUI::AnimationList*)data)}</DisplayString>
    <DisplayString Condition="type == 'D'">{type,en}: {*((URUI::DecoratorsPtr*)data)}</DisplayString>
    <DisplayString Condition="type == 'F'">{type,en}: {*((URUI::FiltersPtr*)data)}</DisplayString>
    <DisplayString Condition="type == 'E'">{type,en}: {*((URUI::FontEffectsPtr*)data)}</DisplayString>
    <DisplayString Condition="type == 'C'">{type,en}: {*((URUI::ColorStopList*)data)}</DisplayString>
    <DisplayString Condition="type == 'S'">{type,en}: {*((URUI::BoxShadowList*)data)}</DisplayString>
    <DisplayString Condition="type == '*'">{type,en}: {*((void**)data)}</DisplayString>
    <DisplayString>Unknown type: {(char)type}</DisplayString>

    <Expand>
      <Item Name="[type]">type</Item>
      <Item Name="[value]" Condition="type == 'B'">*((bool*)data)</Item>
      <Item Name="[value]" Condition="type == 'b'">*((URUI::byte*)data)</Item>
      <Item Name="[value]" Condition="type == 'c'">*((char*)data)</Item>
      <Item Name="[value]" Condition="type == 'f'">*((float*)data)</Item>
      <Item Name="[value]" Condition="type == 'd'">*((double*)data)</Item>
      <Item Name="[value]" Condition="type == 'i'">*((int*)data)</Item>
      <Item Name="[value]" Condition="type == 'I'">*((int64_t*)data)</Item>
      <Item Name="[value]" Condition="type == 'u'">*((unsigned int*)data)</Item>
      <Item Name="[value]" Condition="type == 'U'">*((uint64_t*)data)</Item>
      <Item Name="[value]" Condition="type == 's'">*((URUI::String*)data)</Item>
      <Item Name="[value]" Condition="type == '2'">*((URUI::Vector2f*)data)</Item>
      <Item Name="[value]" Condition="type == '3'">*((URUI::Vector3f*)data)</Item>
      <Item Name="[value]" Condition="type == '4'">*((URUI::Vector4f*)data)</Item>
      <Item Name="[value]" Condition="type == 'g'">*((URUI::Colourf*)data)</Item>
      <Item Name="[value]" Condition="type == 'h'">*((URUI::Colourb*)data)</Item>
      <Item Name="[value]" Condition="type == 'p'">*((URUI::ScriptInterface**)data)</Item>
      <Item Name="[value]" Condition="type == 't'">*((URUI::TransformPtr*)data)</Item>
      <Item Name="[value]" Condition="type == 'T'">*((URUI::TransitionList*)data)</Item>
      <Item Name="[value]" Condition="type == 'A'">*((URUI::AnimationList*)data)</Item>
      <Item Name="[value]" Condition="type == 'D'">*((URUI::DecoratorsPtr*)data)</Item>
      <Item Name="[value]" Condition="type == 'F'">*((URUI::FiltersPtr*)data)</Item>
      <Item Name="[value]" Condition="type == 'E'">*((URUI::FontEffectsPtr*)data)</Item>
      <Item Name="[value]" Condition="type == 'C'">*((URUI::ColorStopList*)data)</Item>
      <Item Name="[value]" Condition="type == 'S'">*((URUI::BoxShadowList*)data)</Item>
      <Item Name="[value]" Condition="type == '*'">*((void**)data)</Item>
    </Expand>
  </Type>
  <Type Name="URUI::PropertyIdSet">
    <Intrinsic Name="popcount_s1" Expression="x - ((x &gt;&gt; 1) &amp; 0x5555555555555555ULL)">
      <Parameter Name="x" Type="unsigned __int64" />
    </Intrinsic>
    <Intrinsic Name="popcount_s2" Expression="(x &amp; 0x3333333333333333ULL) + ((x &gt;&gt; 2) &amp; 0x3333333333333333ULL)">
      <Parameter Name="x" Type="unsigned __int64" />
    </Intrinsic>
    <Intrinsic Name="popcount_s3" Expression="(x + (x &gt;&gt; 4)) &amp; 0x0F0F0F0F0F0F0F0FULL">
      <Parameter Name="x" Type="unsigned __int64" />
    </Intrinsic>
    <Intrinsic Name="popcount64" Expression="(popcount_s3(popcount_s2(popcount_s1(x))) * 0x0101010101010101ULL) &gt;&gt; 56">
      <Parameter Name="x" Type="unsigned __int64" />
    </Intrinsic>
    <Intrinsic Name="size" Expression="popcount64(defined_ids._Array[0]) + popcount64(defined_ids._Array[1])" />
    <DisplayString Condition="size() == 0">{{ empty }}</DisplayString>
    <DisplayString>{{ size={size()} }}</DisplayString>
    <Expand>
      <Item Name="[size]" ExcludeView="simple">size()</Item>
      <CustomListItems MaxItemsPerView="128">
        <Variable Name="i" InitialValue="1" />
        <Loop>
          <Break Condition="i &gt;= 128" />
          <If Condition="(defined_ids._Array[i / 64] &amp; (1ULL &lt;&lt; (i % 64))) != 0">
            <Item Name="[{i}]">(URUI::PropertyId)i,en</Item>
          </If>
          <Exec>i = i + 1</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>
</AutoVisualizer>
