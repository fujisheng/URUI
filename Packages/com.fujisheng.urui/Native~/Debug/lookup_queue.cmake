# Generate one optional copy; do not edit upstream RmlUi sources.
file(READ "${rmlui_SOURCE_DIR}/Source/Core/ElementUtilities.cpp" lookup_code)
set(anchor "Element* ElementUtilities::GetElementById(Element* root_element, const String& id)\n{")
string(FIND "${lookup_code}" "${anchor}" anchor_position)
if(anchor_position LESS 0)
 message(FATAL_ERROR "RmlUi lookup function changed; re-audit before patch")
endif()
string(FIND "${lookup_code}" "void ElementUtilities::GetElementsByTagName" next_function)
math(EXPR function_length "${next_function}-${anchor_position}")
string(SUBSTRING "${lookup_code}" 0 ${anchor_position} before_lookup)
string(SUBSTRING "${lookup_code}" ${anchor_position} ${function_length} lookup_function)
string(SUBSTRING "${lookup_code}" ${next_function} -1 after_lookup)
string(SHA256 lookup_function_hash "${lookup_function}")
if(NOT lookup_function_hash STREQUAL "7d658891d846554b936859391e0c5c22f3439ea70a027976e932e68346440b6a")
 message(FATAL_ERROR "RmlUi lookup semantics changed; re-audit exact original body")
endif()
string(REPLACE "${anchor}" "${anchor}\n\turui_lookup::Scope lookup_scope;\n\tif(urui_lookup::inline_enabled)return urui_lookup::InlineFind(root_element,id,lookup_scope);" lookup_function "${lookup_function}")
set(visit_anchor "Element* element = search_queue.front();")
string(LENGTH "${lookup_function}" lookup_length_before)
string(REPLACE "${visit_anchor}" "" lookup_without_visit "${lookup_function}")
string(LENGTH "${lookup_without_visit}" lookup_length_after)
string(LENGTH "${visit_anchor}" lookup_anchor_length)
math(EXPR lookup_visit_count "(${lookup_length_before}-${lookup_length_after})/${lookup_anchor_length}")
if(NOT lookup_visit_count EQUAL 1)
 message(FATAL_ERROR "Lookup visit anchor must occur exactly once")
endif()
string(REPLACE "${visit_anchor}" "lookup_scope.Visit(search_queue.size());\n\t\t${visit_anchor}" lookup_function "${lookup_function}")
set(lookup_code "${before_lookup}${lookup_function}${after_lookup}")
string(REPLACE "\"../../Include/RmlUi/" "\"RmlUi/" lookup_code "${lookup_code}")
set(generated_lookup "${CMAKE_CURRENT_BINARY_DIR}/ElementUtilities.lookup.cpp")
file(WRITE "${generated_lookup}" "#include \"Debug/lookup_probe.h\"\n${lookup_code}")
get_target_property(lookup_sources rmlui_core SOURCES)
set(lookup_source_count 0)
foreach(lookup_source IN LISTS lookup_sources)
 if(lookup_source STREQUAL "ElementUtilities.cpp")
  math(EXPR lookup_source_count "${lookup_source_count}+1")
 endif()
endforeach()
if(NOT lookup_source_count EQUAL 1)
 message(FATAL_ERROR "Expected exactly one original ElementUtilities source")
endif()
list(REMOVE_ITEM lookup_sources ElementUtilities.cpp)
set_property(TARGET rmlui_core PROPERTY SOURCES "${lookup_sources};${generated_lookup}")
set_source_files_properties("${generated_lookup}" TARGET_DIRECTORY rmlui_core PROPERTIES INCLUDE_DIRECTORIES "${CMAKE_CURRENT_SOURCE_DIR};${rmlui_SOURCE_DIR}/Source/Core")
target_sources(URUIBridge PRIVATE Debug/lookup_queue_tests.cpp)
target_include_directories(URUIBridge PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
